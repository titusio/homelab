{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/(^|/)Containerfile[^/]*$/"
    ]
  },
  "flux": {
    "enabled": true,
    "managerFilePatterns": [
      "/kubernetes/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Container images pinned in NixOS host modules",
      "managerFilePatterns": ["/^vps/.+\\.nix$/"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^\"\\s]+):(?<currentValue>[^\":\\s]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Disable nix — handled by update-flake.yml",
      "matchManagers": ["nix"],
      "enabled": false
    },
    {
      "description": "Auto-merge swiftster bumps; the rebuild webhook picks them up",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/titusio/swiftster"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["digest", "patch", "minor"]
    },
    {
      "description": "Group infrastructure chart updates into one PR",
      "matchFileNames": ["kubernetes/infrastructure/**"],
      "groupName": "infrastructure",
      "groupSlug": "infrastructure"
    },
    {
      "description": "Auto-merge GitHub Actions digest/patch bumps",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["digest", "patch", "minor"]
    }
  ],
  "hostRules": [
    {
      "matchHost": "git.titusio.net",
      "hostType": "docker"
    }
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "labels": ["renovate"],
  "commitMessagePrefix": "chore(deps):"
}
